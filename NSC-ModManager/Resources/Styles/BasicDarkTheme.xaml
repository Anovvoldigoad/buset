<!--
    BasicDarkTheme.xaml
    Pengganti ModernWpfUI/XamlControlsResources.
    Tujuan: tampilan gelap yang konsisten memakai style WPF native murni
    (SolidColorBrush + Setter biasa), TANPA bergantung pada:
      - DWM composition (Mica/Acrylic/Blur system brush)
      - Kontrol Fluent Windows 10/11 (NavigationView, CommandBar, dll)
    Semua brush di sini solid color agar aman & ringan dirender lewat
    Wine/Winlator (tidak butuh efek komposisi jendela sistem).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Palet warna dasar ===== -->
    <SolidColorBrush x:Key="App.Bg"          Color="#FF1E1E1E"/>
    <SolidColorBrush x:Key="App.Surface"     Color="#FF2A2A2E"/>
    <SolidColorBrush x:Key="App.SurfaceEdge" Color="#FF3F3F46"/>
    <SolidColorBrush x:Key="App.Accent"      Color="#FFAF1717"/>
    <SolidColorBrush x:Key="App.AccentHover" Color="#FFD22525"/>
    <SolidColorBrush x:Key="App.Text"        Color="#FFF2F2F2"/>
    <SolidColorBrush x:Key="App.TextDim"     Color="#FFB5B5B5"/>

    <!-- ===== Window ===== -->
    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource App.Bg}"/>
        <Setter Property="Foreground" Value="{StaticResource App.Text}"/>
    </Style>

    <!-- ===== Button ===== -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource App.Surface}"/>
        <Setter Property="Foreground" Value="{StaticResource App.Text}"/>
        <Setter Property="BorderBrush" Value="{StaticResource App.SurfaceEdge}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource App.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource App.AccentHover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== TextBlock / Label ===== -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource App.Text}"/>
    </Style>
    <Style TargetType="Label">
        <Setter Property="Foreground" Value="{StaticResource App.Text}"/>
    </Style>

    <!-- ===== TextBox ===== -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource App.Surface}"/>
        <Setter Property="Foreground" Value="{StaticResource App.Text}"/>
        <Setter Property="BorderBrush" Value="{StaticResource App.SurfaceEdge}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="CaretBrush" Value="{StaticResource App.Text}"/>
    </Style>

    <!-- ===== ComboBox (style ringan, tetap pakai template default WPF) ===== -->
    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource App.Surface}"/>
        <Setter Property="Foreground" Value="{StaticResource App.Text}"/>
        <Setter Property="BorderBrush" Value="{StaticResource App.SurfaceEdge}"/>
    </Style>
    <Style TargetType="ComboBoxItem">
        <Setter Property="Background" Value="{StaticResource App.Surface}"/>
        <Setter Property="Foreground" Value="{StaticResource App.Text}"/>
    </Style>

    <!-- ===== CheckBox (dipakai sebagai pengganti ui:ToggleSwitch) ===== -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource App.Text}"/>
    </Style>

    <!-- ===== ScrollViewer / ScrollBar dasar (tanpa efek fancy) ===== -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="{StaticResource App.Surface}"/>
    </Style>

</ResourceDictionary>
