<Application x:Class="NSC_ModManager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NSC_ModManager"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             StartupUri="View/TitleView.xaml"  Startup="App_Startup">
    <Application.Resources>
        <ResourceDictionary>
            <!--
                Font "CC2 RocknRoll Latin DB" (Comicraft, komersial) diganti dengan
                "Bangers" (Google Fonts, SIL Open Font License 1.1) — gaya visual serupa
                (bold, comic/display), bebas lisensi untuk dibundel & didistribusikan.
            -->
            <FontFamily x:Key="NarutoFont">./Resources/Fonts/#Bangers</FontFamily>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/BasicDarkTheme.xaml" />
                <ResourceDictionary Source="Resources/Styles/LightStyle.xaml" />
                <ResourceDictionary Source="Resources/Localization/lang.xaml" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>
            <!-- Other app resources here -->
        </ResourceDictionary>
    </Application.Resources>
</Application>
